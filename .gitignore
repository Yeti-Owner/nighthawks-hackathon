# NPM / React / TypeScript
# ==========================================
node_modules/
/build
/dist
.cache/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.prettiercache

# TypeScript specific
*.tsbuildinfo

# ==========================================
